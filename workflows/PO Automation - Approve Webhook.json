      "id": "ap-lookup",
      "name": "Lookup PO",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "BAQOyTX5ZoXCMwEF",
          "name": "Google Sheets account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Server-side state machine: only PENDING -> APPROVED/DECLINED is allowed.\nconst req = $('Validate Request').first().json;\nconst row = $input.first().json || {};\nconst found = row.PO_Number !== undefined && String(row.PO_Number).trim() === req.po_number;\nconst stop = (status, message, extra = {}) => [{ json: { ...req, proceed: false, http_status: status,\n  http_body: { success: false, message, ...extra } } }];\n\nif (!found) return stop(404, 'PO not found');\nconst state = String(row.Approval_State || '').trim().toUpperCase();\n\nif (state === req.decision) {            // idempotent replay: same decision already applied\n  return [{ json: { ...req, proceed: false, http_status: 200,\n    http_body: { success: true, already_processed: true, state,\n      message: 'PO already ' + state.toLowerCase() + '; no action taken' } } }];\n}\nif (state === 'APPROVED' || state === 'DECLINED') return stop(409, 'PO already ' + state.toLowerCase(), { state });\nif (state === 'PROCESSING') return stop(409, 'A decision for this PO is already in progress', { state });\nif (state !== 'PENDING') return stop(409, 'PO is not awaiting approval', { state });\n\nconst to = String(row.Supplier_Email || '').trim();\nconst body = String(row.Drafted_Email || '').trim();\nif (req.decision === 'APPROVED') {\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(to)) return stop(422, 'No valid supplier email on file for this PO');\n  if (!body) return stop(422, 'No stored draft for this PO');\n}\nreturn [{ json: { ...req, proceed: true, supplier_email: to, email_body: body,\n  subject: 'Urgent: Status update required for PO ' + req.po_number } }];"
      },
