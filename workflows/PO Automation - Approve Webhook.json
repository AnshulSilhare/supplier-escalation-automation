        "jsCode": "const d = $('Decide').first().json;\nlet gmailId = '';\ntry { gmailId = $('Send Supplier Email').first().json.id || ''; } catch (e) { /* decline path: no email */ }\nreturn [{ json: {\n  po_number: d.po_number, decision: d.decision, reviewer: d.reviewer, key: d.idempotency_key,\n  gmail_id: gmailId, now: new Date().toISOString(),\n  action_taken: d.decision === 'APPROVED' ? 'Supplier Email Sent' : 'Declined by Reviewer'\n} }];"
