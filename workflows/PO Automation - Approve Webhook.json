      "id": "ap-hook",
      "name": "Webhook"
    },
    {
      "parameters": {
        "jsCode": "// Never trust the browser: validate shape only; recipient/body come from the sheet.\nconst b = $input.first().json.body || {};\nconst po = String(b.po_number ?? '').trim();\nconst decision = String(b.decision || '').toUpperCase();\nconst key = String(b.idempotency_key || '').slice(0, 64);\nconst reviewer = String(b.reviewer || 'unverified').replace(/[^\\w .@-]/g, '').slice(0, 60);\nlet error = null;\nif (!/^\\d{5,12}$/.test(po)) error = 'Invalid po_number';\nelse if (!['APPROVED', 'DECLINED'].includes(decision)) error = 'decision must be APPROVED or DECLINED';\nreturn [{ json: {\n  valid: !error, po_number: po, decision, reviewer, idempotency_key: key,\n  http_status: error ? 400 : 200,\n  http_body: { success: false, message: error || '' }\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "ap-validate",
      "name": "Validate Request"
    },
