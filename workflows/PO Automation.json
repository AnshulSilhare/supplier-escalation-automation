      "parameters": {
        "sendTo": "anshulsilhare25@gmail.com",
        "subject": "=[Daily Recap] PO Escalation Run Summary \u2013 {{ $json.run_date }}",
        "message": "=<div style=\"font-family: sans-serif; line-height: 1.5; color: #333;\">   <h3 style=\"color: #0052cc; margin-bottom: 8px;\">Daily PO Escalation Execution Summary</h3>   <p>The automated procurement check has concluded for <strong>{{ $json.run_date }}</strong>.</p>    <table style=\"border-collapse: collapse; width: 100%; max-width: 480px; margin: 16px 0;\">     <tr style=\"border-bottom: 1px solid #eee;\">       <td style=\"padding: 6px 0;\"><strong>Total POs Evaluated:</strong></td>       <td style=\"padding: 6px 0; text-align: right;\">{{ $json.total_evaluated }}</td>     </tr>     <tr style=\"border-bottom: 1px solid #eee;\">       <td style=\"padding: 6px 0; color: #0d8a43;\"><strong>Supplier Emails Approved & Sent:</strong></td>       <td style=\"padding: 6px 0; text-align: right; color: #0d8a43;\"><strong>{{ $json.emails_sent_count }}</strong></td>     </tr>     <tr style=\"border-bottom: 1px solid #eee;\">       <td style=\"padding: 6px 0; color: #d9381e;\"><strong>Escalations Declined:</strong></td>       <td style=\"padding: 6px 0; text-align: right; color: #d9381e;\"><strong>{{ $json.declined_count }}</strong></td>     </tr>     <tr style=\"border-bottom: 1px solid #eee;\">       <td style=\"padding: 6px 0;\"><strong>No Action Needed (On-Track):</strong></td>       <td style=\"padding: 6px 0; text-align: right;\">{{ $json.no_action_count }}</td>     </tr>     <tr>       <td style=\"padding: 6px 0; color: #c92a2a;\"><strong>Dispatch Failures:</strong></td>       <td style=\"padding: 6px 0; text-align: right;\">{{ $json.failed_count }}</td>     </tr>   </table>    <p style=\"font-size: 13px; color: #666;\">     \u2022 Approved POs: {{ $json.sent_po_list }}<br/>     \u2022 Declined POs: {{ $json.declined_po_list }}   </p>    <p style=\"font-size: 12px; color: #888; margin-top: 20px;\">     All line-item audit events have been appended to the <code>Execution_Log</code> sheet tab.   </p> </div>",
        "options": {}
      },
