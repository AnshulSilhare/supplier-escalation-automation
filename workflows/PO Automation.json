      "parameters": {
        "jsCode": "// Pick the supplier behind the single highest-risk flagged PO (score desc, then lowest runway)\nconst items = $input.all().map(i => i.json);\nif (!items.length) return [];\nitems.sort((a, b) => (b.risk_score - a.risk_score) || ((parseFloat(a.Inventory_Days) || 99) - (parseFloat(b.Inventory_Days) || 99)));\nreturn [{ json: { target_supplier: items[0].Supplier_Name, target_po: items[0].PO_Number } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        100
      ],
      "id": "6ef91272-47c1-4b10-9144-edcd5a85e486",
      "name": "Identify Target Supplier",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "function safe(name) { try { return $(name).all() || []; } catch (e) { return []; } }\nconst flagged = safe('Log Pending Escalation');\nconst passed = safe('Log No Action');\nlet total = 0; try { total = $('Read PO Tracker').all().length; } catch (e) {}\nreturn [{ json: {\n  run_date: new Date().toLocaleDateString('en-GB'),\n  total_evaluated: total,\n  flagged_count: flagged.length,\n  auto_passed_count: passed.length,\n  in_workflow_count: Math.max(0, total - flagged.length - passed.length),\n  flagged_po_list: flagged.map(i => i.json.PO_Number || 'N/A').join(', ') || 'None'\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        500
      ],
