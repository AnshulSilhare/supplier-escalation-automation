        "jsCode": "// 6 Operational Risk Criteria Evaluator  (single source of truth for scoring in this workflow)\n// \u2500\u2500 Config: tune thresholds HERE and keep README/dashboards in sync \u2500\u2500\nconst CFG = { RUNWAY_DAYS: 2.0, OTD_MIN: 85.0, FILL_MIN: 90.0, ESCALATE_AT: 4, FOLLOW_UP_AT: 2, COOLDOWN_HOURS: 72 };\n// AS_OF: a fixed 'YYYY-MM-DD' makes the frozen demo dataset reproducible. Set to null to run live (today, UTC).\nconst AS_OF = '2026-09-25';\n\nconst now = new Date();\nconst asOf = AS_OF ? new Date(AS_OF) : new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));\n\nconst out = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (row.PO_Number === undefined || String(row.PO_Number).trim() === '') continue;   // ignore blank rows\n\n  const expDate = new Date(row.Expected_Date);\n  const isOverdue = !isNaN(expDate.getTime()) && expDate < asOf;\n  const isPendingASN = (row.ASN_Status || '').trim().toLowerCase() === 'pending';\n  const runway = parseFloat(row.Inventory_Days) || 0;\n  const isCriticalRunway = runway < CFG.RUNWAY_DAYS;\n  const otd = parseFloat(row.Supplier_OTD) || 0;\n  const isOtdShortfall = otd < CFG.OTD_MIN;\n\n  const qty = parseFloat(row.Qty) || 0;\n  const deliv = parseFloat(row.Delivered_Qty != null && row.Delivered_Qty !== '' ? row.Delivered_Qty : (row.Qty || 0));\n  const fillRate = (row.Fill_Rate != null && row.Fill_Rate !== '') ? parseFloat(row.Fill_Rate) : (qty > 0 ? (deliv / qty * 100) : 100);\n  const isFillRateShortfall = fillRate < CFG.FILL_MIN;\n  const isHighCrit = (row.Material_Criticality || '').trim().toLowerCase() === 'high';\n\n  const failedCriteria = [];\n  if (isOverdue) failedCriteria.push('Overdue Delivery Date');\n  if (isPendingASN) failedCriteria.push('Pending ASN');\n  if (isCriticalRunway) failedCriteria.push(`Critical Runway (${runway}d < ${CFG.RUNWAY_DAYS}d)`);\n  if (isOtdShortfall) failedCriteria.push(`Historical OTD Shortfall (${otd}% < ${CFG.OTD_MIN}%)`);\n  if (isFillRateShortfall) failedCriteria.push(`Fill Rate Shortfall (${fillRate.toFixed(1)}% < ${CFG.FILL_MIN}%)`);\n  if (isHighCrit) failedCriteria.push('High Material Criticality');\n\n  const riskScore = failedCriteria.length;\n  let riskLevel = 'NORMAL';\n  if (riskScore >= CFG.ESCALATE_AT || (isCriticalRunway && isPendingASN)) riskLevel = 'ESCALATE';\n  else if (riskScore >= CFG.FOLLOW_UP_AT) riskLevel = 'FOLLOW_UP';\n\n  // Do not re-flag POs already waiting on a human, or recently decided (cooldown).\n  const state = String(row.Approval_State || '').trim().toUpperCase();\n  const lastTs = new Date(row.Last_Action_Timestamp);\n  const hoursSince = isNaN(lastTs.getTime()) ? Infinity : (now - lastTs) / 36e5;\n  const inFlight = state === 'PENDING' || state === 'PROCESSING';\n  const cooling = (state === 'APPROVED' || state === 'DECLINED') && hoursSince < CFG.COOLDOWN_HOURS;\n  if (riskLevel !== 'NORMAL' && (inFlight || cooling)) continue;\n\n  // Deterministic fallback draft (used if the LLM draft step fails)\n  let emailBody = '';\n  if (riskLevel !== 'NORMAL') {\n    const urgency = riskLevel === 'ESCALATE' ? 'URGENT ESCALATION' : 'Follow-Up Notice';\n    emailBody = `Dear ${row.Supplier_Name} Logistics Team,\\n\\n` +\n      `[${urgency}] Regarding PO #${row.PO_Number} for SKU ${row.SKU}.\\n` +\n      `Our Supply Chain Control Tower flagged this order with Risk Score ${riskScore}/6 due to:\\n` +\n      failedCriteria.map(c => `  - ${c}`).join('\\n') + `\\n\\n` +\n      `Delivered: ${deliv}/${qty} (${fillRate.toFixed(1)}% Fill Rate). Current inventory runway is ${runway} days.\\n` +\n      `Please confirm carrier docket number and guaranteed dispatch ETA within 24 hours to prevent plant stockout.\\n\\n` +\n      `Best regards,\\nProcurement Operations`;\n  }\n\n  out.push({ json: {\n    ...row,\n    Delivered_Qty: deliv,\n    Fill_Rate: fillRate.toFixed(1),\n    risk_score: riskScore,\n    risk_score_display: `${riskScore}/6`,\n    risk_level: riskLevel,\n    failed_criteria: failedCriteria,\n    _risk_reason: failedCriteria.length > 0 ? failedCriteria.join('; ') : 'On Track',\n    needs_flag: riskLevel !== 'NORMAL',\n    as_of_date: asOf.toISOString().slice(0, 10),\n    supplier_email_body: emailBody,\n    Last_Action_Timestamp: now.toISOString()\n  } });\n}\nreturn out;\n"
      },
