    {
      "parameters": {
        "jsCode": "// Scan the cached tracker data for the first critical PO\nconst trackerItems = $('Read PO Tracker').all();\nconst escalated = trackerItems.find(item => \n    item.json.ASN_Status === 'Pending' || item.json.Inventory_Days < 3\n);\n\nconst target = escalated ? escalated.json.Supplier_Name : \"Global Supply Chain Logistics\";\nreturn { json: { target_supplier: target } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -912
      ],
      "id": "6ef91272-47c1-4b10-9144-edcd5a85e486",
      "name": "Identify Target Supplier",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Helper to safely read output from nodes that might not have run in this execution\nfunction getSafeItems(nodeName) {\n  try {\n    return $(nodeName).all() || [];\n  } catch (error) {\n    return [];\n  }\n}\n\nconst sentItems = getSafeItems('Log Email Sent');\nconst declinedItems = getSafeItems('Log Declined Escalation');\nconst failedItems = getSafeItems('Log Email Failed');\nconst noActionItems = getSafeItems('Log No Action');\n\nconst totalEvaluated = sentItems.length + declinedItems.length + failedItems.length + noActionItems.length;\n\nreturn [{\n  json: {\n    run_date: new Date().toLocaleDateString('en-GB'),\n    total_evaluated: totalEvaluated,\n    emails_sent_count: sentItems.length,\n    declined_count: declinedItems.length,\n    failed_count: failedItems.length,\n    no_action_count: noActionItems.length,\n    sent_po_list: sentItems.map(item => item.json.PO_Number || 'N/A').join(', ') || 'None',\n    declined_po_list: declinedItems.map(item => item.json.PO_Number || 'N/A').join(', ') || 'None'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        -784
      ],
      "id": "291e3d04-d140-4403-9428-09731286641b",
      "name": "Calculates run stats",
      "executeOnce": true
    },
