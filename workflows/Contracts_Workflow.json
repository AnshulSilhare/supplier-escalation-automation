      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "webhookId": "run-contracts"
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "https://docs.google.com/spreadsheets/d/1Vmn2HdHiL1h2z0vxY4KM8c5BaGTz7VDFRrHBHpX7niY/edit",
          "mode": "url"
        },
        "sheetName": {
          "__rl": true,
          "value": "Contracts",
          "mode": "name"
        },
        "options": {}
      },
      "id": "node-3",
      "name": "Read Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        200,
        100
      ],
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "BAQOyTX5ZoXCMwEF",
          "name": "Google Sheets account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nlet expiring_30d = 0;\nlet active_coverage = 0;\nlet total_value = 0;\nrows.forEach(row => {\n  if (parseInt(row['Days to Expiry'] || '0') <= 30) expiring_30d++;\n  if (row['Alert Level'] === 'Normal' || row['Alert Level'] === 'Low') active_coverage++;\n  total_value += parseFloat(row['Annual Value'] || '0') || 0;\n});\nconst summary = {\n  total_contracts: rows.length,\n  expiring_30d,\n  active_coverage,\n  avg_value: rows.length ? total_value / rows.length : 0\n};\nreturn [{ json: { summary, contracts: rows, last_updated: new Date().toISOString() } }];"
      },
      "id": "node-4",
      "name": "Process Contracts Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        100
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=# Please provide a brief executive narrative on the following contracts summary and data:\n{{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-5",
      "name": "Generate AI Narrative",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        600,
        100
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {}
      },
      "id": "node-6",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        600,
        300
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "q5z2LHOvO4y9vDZx",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nlet baseData = $('Process Contracts Data').first().json;\nlet aiText = '';\ntry {\n  const aiOut = $('Generate AI Narrative').first().json;\n  aiText = aiOut.text || aiOut.output || '';\n  if (aiText) {\n    sd.ai_narrative = aiText;\n    sd.ai_ts = Date.now();\n  }\n} catch (e) {\n  aiText = sd.ai_narrative || '';\n}\nif (!aiText && sd.ai_narrative) aiText = sd.ai_narrative;\nbaseData.ai_narrative = aiText;\nreturn [{ json: baseData }];"
      },
      "id": "node-7",
      "name": "Merge Data + AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        100
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "node-8",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1000,
        100
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Free-tier guard: reuse the last AI text for 6 hours; a POST 'Run' forces a refresh.\nconst sd = $getWorkflowStaticData('global');\nconst data = $input.first().json;\nconst TTL_MS = 6 * 3600 * 1000;\nlet forced = false; try { forced = $('Run Contracts').isExecuted; } catch (e) {}\nconst fresh = !forced && !!sd.ai_narrative && !!sd.ai_ts && (Date.now() - sd.ai_ts) < TTL_MS;\nreturn [{ json: { ...data, _cache_fresh: fresh } }];"
      },
      "id": "cache-check-contr",
      "name": "AI Cache Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        -20
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "fresh",
              "leftValue": "={{ $json._cache_fresh }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cache-if-contr",
      "name": "AI Cache Fresh?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        760,
        -20
      ]
    }
  ],
