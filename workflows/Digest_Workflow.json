    {
      "parameters": {
        "jsCode": "const poData = $('Read PO Tracker').all().map(i => i.json);\nconst scData = $('Read Scorecard').all().map(i => i.json);\nconst qaData = $('Read Quality').all().map(i => i.json);\n\nconst today = new Date().toLocaleDateString('en-IN', {weekday:'long', year:'numeric', month:'long', day:'numeric'});\n\nconst activePOs = poData.length;\nconst overduePOs = poData.filter(p => p.Status === 'OVERDUE' || p.Status === 'AI_ESCALATED' || p.Status === 'MANUAL_ESCALATED').length;\n\nconst totalSuppliers = scData.length;\nconst avgOTIF = scData.length ? (scData.reduce((s,r) => s + parseFloat(r.OTIF_Pct||0), 0) / scData.length).toFixed(1) : 0;\nconst atRisk = scData.filter(r => {\n  const otif = parseFloat(r.OTIF_Pct||0);\n  const qual = parseFloat(r.Quality_Pct||0);\n  const score = (otif*0.3 + qual*0.3 + (100-Math.abs(parseFloat(r.Cost_Variance_Pct||0)))*0.2 + (100-parseFloat(r.Avg_Lead_Days||0)*5)*0.2);\n  return score < 70;\n}).length;\n\nconst totalIncidents = qaData.length;\nconst openCases = qaData.filter(q => q.Status === 'OPEN' || q.Status === 'INVESTIGATING').length;\nconst flaggedSuppliers = [...new Set(qaData.filter(q => {\n  const rate = parseFloat(q.Qty_Rejected||0) / (parseFloat(q.Qty_Received)||1) * 100;\n  return rate > 5;\n}).map(q => q.Supplier))].length;\n\nconst health = { active_pos: activePOs, overdue_pos: overduePOs, total_suppliers: totalSuppliers, avg_otif: avgOTIF, at_risk_suppliers: atRisk, total_incidents: totalIncidents, open_quality_cases: openCases, flagged_suppliers: flaggedSuppliers };\n\nconst modules = [\n  { name: 'Escalation Console', status: overduePOs > 0 ? 'alert' : 'healthy', metric: `${activePOs} Active POs, ${overduePOs} overdue`, last_run: 'Live' },\n  { name: 'Supplier Scorecard', status: atRisk > 1 ? 'warning' : 'healthy', metric: `${atRisk} at-risk suppliers`, last_run: 'Live' },\n  { name: 'Quality Tracker', status: flaggedSuppliers > 0 ? 'alert' : 'healthy', metric: `${openCases} open cases, ${flaggedSuppliers} flagged`, last_run: 'Live' }\n];\n\nreturn [{ json: { date: today, health, modules, po_data: poData, scorecard_data: scData, quality_data: qaData, last_updated: new Date().toISOString() } }];"
      },
