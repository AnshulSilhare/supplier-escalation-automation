{
  "name": "PROCUREMENT SPEND TRACKER",
  "nodes": [
    {
      "parameters": {
        "path": "spend-data",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "GET Spend",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "run-spend",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2",
      "name": "Run Spend",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "https://docs.google.com/spreadsheets/d/1Vmn2HdHiL1h2z0vxY4KM8c5BaGTz7VDFRrHBHpX7niY/edit",
          "mode": "url"
        },
        "sheetName": {
          "__rl": true,
          "value": "Spend_Data",
          "mode": "name"
        },
        "options": {}
      },
      "id": "3",
      "name": "Read Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        400,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "BAQOyTX5ZoXCMwEF",
          "name": "Google Sheets account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nconst summary = { total_spend: 10000, budget_utilization: 80, top_category: 'IT', cost_savings: 500 };\nreturn [{ json: { summary, spend_data: rows, category_chart: {}, supplier_chart: {}, last_updated: new Date().toISOString() } }];"
      },
      "id": "4",
      "name": "Process Spend Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {},
      "id": "5",
      "name": "Generate AI Narrative",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        800,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "modelName": "models/gemini-pro",
        "options": {}
      },
      "id": "5a",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        800,
        200
      ],
      "credentials": {
        "googleGeminiApi": {
          "id": "q5z2LHOvO4y9vDZx",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const data = $('Process Spend Data').first().json;\nconst aiData = $('Generate AI Narrative').first().json;\ndata.ai_narrative = aiData.text || aiData.output || '';\nreturn [{ json: data }];"
      },
      "id": "6",
      "name": "Merge Data + AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "7",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ],
      "executeOnce": true
    }
  ],
  "connections": {
