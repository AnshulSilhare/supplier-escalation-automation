          "id": "q5z2LHOvO4y9vDZx",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nlet baseData = $('Process Spend Data').first().json;\nlet aiText = '';\ntry {\n  const aiOut = $('Generate AI Narrative').first().json;\n  aiText = aiOut.text || aiOut.output || '';\n  if (aiText) {\n    sd.ai_narrative = aiText;\n    sd.ai_ts = Date.now();\n  }\n} catch (e) {\n  aiText = sd.ai_narrative || '';\n}\nif (!aiText && sd.ai_narrative) aiText = sd.ai_narrative;\nbaseData.ai_narrative = aiText;\nreturn [{ json: baseData }];"
      },
      "id": "6",
      "name": "Merge Data + AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "7",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Free-tier guard: reuse the last AI text for 6 hours; a POST 'Run' forces a refresh.\nconst sd = $getWorkflowStaticData('global');\nconst data = $input.first().json;\nconst TTL_MS = 6 * 3600 * 1000;\nlet forced = false; try { forced = $('Run Spend').isExecuted; } catch (e) {}\nconst fresh = !forced && !!sd.ai_narrative && !!sd.ai_ts && (Date.now() - sd.ai_ts) < TTL_MS;\nreturn [{ json: { ...data, _cache_fresh: fresh } }];"
      },
      "id": "cache-check-spend",
      "name": "AI Cache Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        -120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "fresh",
              "leftValue": "={{ $json._cache_fresh }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cache-if-spend",
      "name": "AI Cache Fresh?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
