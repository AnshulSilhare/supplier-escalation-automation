        "jsCode": "const rows = $input.all().map(item => item.json);\nconst summary = { total_spend: 10000, budget_utilization: 80, top_category: 'IT', cost_savings: 500 };\nreturn [{ json: { summary, spend_data: rows, category_chart: {}, supplier_chart: {}, last_updated: new Date().toISOString() } }];"
