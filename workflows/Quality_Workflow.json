    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst base = $('Process Quality Data').first().json;\ndelete base._cache_fresh;\nlet text = '';\ntry { const a = $('Generate AI Root Cause').first().json; text = a.text || a.output || ''; } catch (e) { text = ''; }\nif (text) { sd.ai_text = text; sd.ai_ts = Date.now(); }\nelse { text = sd.ai_text || 'AI narrative temporarily unavailable (free-tier quota). Data below is live.'; }\nbase.ai_analysis = text;\nreturn [{ json: base }];"
      },
