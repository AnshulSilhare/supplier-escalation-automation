      "name": "Read Google Sheets",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "BAQOyTX5ZoXCMwEF",
          "name": "Google Sheets account 2"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nlet open_cases = 0;\nlet defect_by_type = {};\nlet supplier_rejects = {};\nlet supplier_received = {};\n\nconst incidents = rows.map(r => {\n  if (r.Status === 'OPEN' || r.Status === 'INVESTIGATING') open_cases++;\n  let type = r.Defect_Type || 'Other';\n  defect_by_type[type] = (defect_by_type[type] || 0) + 1;\n  \n  let sup = r.Supplier;\n  let rej = parseFloat(r.Qty_Rejected||0);\n  let rcv = parseFloat(r.Qty_Received||1);\n  supplier_rejects[sup] = (supplier_rejects[sup] || 0) + rej;\n  supplier_received[sup] = (supplier_received[sup] || 0) + rcv;\n  \n  return { ...r, defect_rate: ((rej/rcv)*100).toFixed(1) };\n});\n\nlet defect_by_supplier = { labels: [], values: [] };\nlet total_rej = 0, total_rcv = 0;\nlet flagged_suppliers = 0;\nfor (const sup in supplier_received) {\n  let rate = (supplier_rejects[sup] / supplier_received[sup]) * 100;\n  defect_by_supplier.labels.push(sup);\n  defect_by_supplier.values.push(rate.toFixed(1));\n  total_rej += supplier_rejects[sup];\n  total_rcv += supplier_received[sup];\n  if (rate > 5) flagged_suppliers++;\n}\n\nlet quality_index = total_rcv ? (100 - ((total_rej/total_rcv)*100)) : 100;\n\nconst summary = {\n  total_incidents: rows.length,\n  open_cases,\n  quality_index: quality_index.toFixed(1),\n  flagged_suppliers\n};\n\nreturn [{ json: { summary, incidents, defect_by_type, defect_by_supplier, last_updated: new Date().toISOString() } }];"
      },
