      "typeVersion": 4.7,
      "position": [
        480,
        400
      ],
      "id": "sc-sheets",
      "name": "Read Google Sheets",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "BAQOyTX5ZoXCMwEF",
          "name": "Google Sheets account 2"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nlet total_suppliers = rows.length;\nlet sum_otif = 0;\nlet sum_qual = 0;\nlet at_risk = 0;\n\nconst suppliers = rows.map(r => {\n  let otif = parseFloat(r.OTIF_Pct||0);\n  let qual = parseFloat(r.Quality_Pct||0);\n  let costVar = parseFloat(r.Cost_Variance_Pct||0);\n  let lead = parseFloat(r.Avg_Lead_Days||0);\n  sum_otif += otif;\n  sum_qual += qual;\n  \n  let score = (otif*0.3) + (qual*0.3) + ((100-Math.abs(costVar))*0.2) + ((100-lead*5)*0.2);\n  let grade = score >= 85 ? 'A' : (score >= 70 ? 'B' : (score >= 55 ? 'C' : 'D'));\n  if (grade === 'C' || grade === 'D') at_risk++;\n  \n  return { name: r.Supplier_Name, grade, otif, quality: qual, costVar, leadDays: lead, score, incidents: r.Incidents_Count };\n});\n\nconst summary = {\n  total_suppliers,\n  avg_otif: total_suppliers ? (sum_otif/total_suppliers).toFixed(1) : 0,\n  avg_quality: total_suppliers ? (sum_qual/total_suppliers).toFixed(1) : 0,\n  at_risk_count: at_risk\n};\n\nreturn [{ json: { summary, suppliers, chartData: { labels: suppliers.map(s => s.name), datasets: suppliers.map(s => [s.otif, s.quality, 100-Math.abs(s.costVar), 100-s.leadDays*5]) }, last_updated: new Date().toISOString() } }];"
      },
      "id": "sc-code",
      "name": "Process Scorecard Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        400
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "You are a supply chain analyst. Based on this supplier scorecard data, write a 3-4 sentence executive summary. Highlight the best and worst performers, flag any risks, and give one specific action recommendation. Data: {{ JSON.stringify($input.first().json) }}",
        "hasOutputParser": false
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        920,
        400
      ],
      "id": "sc-ai",
      "name": "Generate AI Narrative",
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        920,
        600
      ],
      "id": "sc-gemini",
      "name": "Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "q5z2LHOvO4y9vDZx",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst base = $('Process Scorecard Data').first().json;\ndelete base._cache_fresh;\nlet text = '';\ntry { const a = $('Generate AI Narrative').first().json; text = a.text || a.output || ''; } catch (e) { text = ''; }\nif (text) { sd.ai_text = text; sd.ai_ts = Date.now(); }\nelse { text = sd.ai_text || 'AI narrative temporarily unavailable (free-tier quota). Data below is live.'; }\nbase.ai_narrative = text;\nreturn [{ json: base }];"
      },
      "id": "sc-merge",
      "name": "Merge Data + AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        400
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "sc-resp",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1360,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Free-tier guard: reuse the last AI text for 6 hours; a POST 'Run' forces a refresh.\nconst sd = $getWorkflowStaticData('global');\nconst data = $input.first().json;\nconst TTL_MS = 6 * 3600 * 1000;\nlet forced = false; try { forced = $('Run Scorecard').isExecuted; } catch (e) {}\nconst fresh = !forced && !!sd.ai_text && !!sd.ai_ts && (Date.now() - sd.ai_ts) < TTL_MS;\nreturn [{ json: { ...data, _cache_fresh: fresh } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        810,
        230
      ],
      "id": "cache-check-ai_narrative",
      "name": "AI Cache Check"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "fresh",
              "leftValue": "={{ $json._cache_fresh }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        230
      ],
      "id": "cache-if-ai_narrative",
      "name": "AI Cache Fresh?"
    }
