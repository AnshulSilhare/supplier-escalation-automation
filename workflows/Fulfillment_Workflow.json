      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nlet baseData = $('Process Fulfillment Data').first().json;\nlet aiText = '';\ntry {\n  const aiOut = $('Generate AI Narrative').first().json;\n  aiText = aiOut.text || aiOut.output || '';\n  if (aiText) {\n    sd.ai_narrative = aiText;\n    sd.ai_ts = Date.now();\n  }\n} catch (e) {\n  aiText = sd.ai_narrative || '';\n}\nif (!aiText && sd.ai_narrative) aiText = sd.ai_narrative;\nbaseData.ai_narrative = aiText;\nreturn [{ json: baseData }];"
      },
