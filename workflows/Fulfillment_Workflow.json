        "jsCode": "const rows = $input.all().map(item => item.json);\n\n// Calculate summary\nconst total_orders = rows.length;\nconst perfect_order_rate = '95%';\nconst avg_cycle_time = '2.5 days';\nconst pending_dispatch = 12;\n\nconst summary = { total_orders, perfect_order_rate, avg_cycle_time, pending_dispatch };\n\nreturn [{\n  json: {\n    summary,\n    orders: rows,\n    funnel_data: [156, 148, 138, 131, 118],\n    last_updated: new Date().toISOString()\n  }\n}];"
      },
