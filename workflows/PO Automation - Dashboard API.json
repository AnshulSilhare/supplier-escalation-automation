      "parameters": {
        "jsCode": "const trackerRows = $('Read PO_Tracker').all().map(item => item.json);\nconst auditRows = $('Read Execution_Log').all().map(item => item.json);\nconst briefRows = $('Read Risk_Brief').all().map(item => item.json);\n\n// Grab the most recently generated brief (the last row)\nconst latestBrief = briefRows.length > 0 ? briefRows[briefRows.length - 1] : null;\n\nreturn [{\n  json: {\n    tracker: trackerRows,\n    audit_log: auditRows,\n    risk_brief: latestBrief,\n    last_synced: new Date().toISOString()\n  }\n}];"
      },
